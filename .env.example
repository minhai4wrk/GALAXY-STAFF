# ===================================================================
# Galaxy Staff - Biến môi trường mẫu
# Copy file này thành .env rồi sửa giá trị thật. KHÔNG commit file .env.
# ===================================================================

# ---------- PostgreSQL (dùng cho service `db` trong docker-compose) ----------
POSTGRES_USER=galaxy
POSTGRES_PASSWORD=galaxy_dev_password
POSTGRES_DB=galaxy_staff
POSTGRES_PORT=5432

# ---------- Backend ----------
# Trong Docker: host là tên service `db`. Chạy ngoài Docker thì đổi thành localhost.
DATABASE_URL=postgresql+psycopg2://galaxy:galaxy_dev_password@db:5432/galaxy_staff
# DB riêng cho pytest (testing.md: KHÔNG mock database)
TEST_DATABASE_URL=postgresql+psycopg2://galaxy:galaxy_dev_password@db:5432/galaxy_staff_test

# JWT - sinh key thật bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-gia-tri-nay-truoc-khi-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bcrypt cost factor (NFR: >= 12)
BCRYPT_ROUNDS=12

# Mật khẩu mặc định khi Manager tạo tài khoản / reset (FR-AUTH-06, FR-AUTH-11)
DEFAULT_USER_PASSWORD=GalaxyStaff@123

# ---------- Nghiệp vụ rạp ----------
# Múi giờ vận hành rạp. Server prod (Render) chạy UTC, mọi TIMESTAMPTZ lưu UTC.
CINEMA_TIMEZONE=Asia/Ho_Chi_Minh
# Giờ mở cửa - dùng làm mốc 0 của hàm op_minute()
CINEMA_OPEN_HOUR=8
# Deadline đăng ký lịch rảnh: 18h00 Thứ 7 (BR-AV-03)
AVAILABILITY_DEADLINE_WEEKDAY=5
AVAILABILITY_DEADLINE_HOUR=18
# Ràng buộc xếp ca (BR-RS-01, BR-RS-02, BR-RS-03)
MAX_HOURS_PER_WEEK=48
MIN_REST_HOURS_BETWEEN_SHIFTS=8
MAX_CONSECUTIVE_WORK_DAYS=6

# ---------- Upload ảnh News (BR-NW-04) ----------
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_POST=3

# ---------- CORS ----------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Cổng dịch vụ (docker-compose) ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMINER_PORT=8080
SWAGGER_PORT=8081

# ---------- Frontend (Vite - chỉ biến VITE_* mới lộ ra client) ----------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/notifications
