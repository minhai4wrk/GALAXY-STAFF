{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias @/ -> src/ (khớp với resolve.alias trong vite.config.ts).
       Không dùng baseUrl: TypeScript 7.0 sẽ bỏ hỗ trợ, path tương đối là đủ. */
    "paths": { "@/*": ["./src/*"] },

    /* Strict mode bắt buộc theo CLAUDE.md — không được dùng `any` */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
